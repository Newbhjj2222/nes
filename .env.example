NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nes:nes_password@localhost:5432/nes?schema=public
REDIS_URL=redis://localhost:6379

# Generate each with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
COOKIE_SECRET=change-me-change-me-change-me-change-me
API_KEY_PEPPER=change-me-change-me-change-me-change-me
WEBHOOK_SIGNING_SECRET=change-me-change-me-change-me-change-me

CORS_ORIGINS=http://localhost:5173

# PawaPay SANDBOX only. Never commit real tokens.
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_BASE_URL=http://localhost:4000
# Providers users may pick (codes from PawaPay active configuration). Verify in your sandbox dashboard.
PAWAPAY_PROVIDERS=MTN_MOMO_RWA
# Off until fees, limits and eligibility are approved by compliance.
WITHDRAWALS_ENABLED=false
RECONCILE_INTERVAL_MS=300000

# Must stay false until merchant authorization, legal review and compliance approval.
LIVE_PAYMENTS_ENABLED=false
